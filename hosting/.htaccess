# Ustawienia serwera dla wersji strony na zwykłym hostingu (np. cyber_Folks).
# Ten plik automat kopiuje do głównego folderu strony (public_html) – nie trzeba go zmieniać.

Options -Indexes
DirectoryIndex index.html

# zawsze https://
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# adres bez ukośnika na końcu → z ukośnikiem (np. /marki → /marki/), tak jak w mapie strony
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/)$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# własna strona „nie znaleziono”
ErrorDocument 404 /404.html

# obrazki do udostępniania (Facebook, X) nie mają rozszerzenia – mówimy przeglądarce, że to PNG
<FilesMatch "^(opengraph-image|twitter-image)$">
  ForceType image/png
</FilesMatch>
<FilesMatch "^ads\.txt$">
  ForceType text/plain
</FilesMatch>
<FilesMatch "^sitemap\.xml$|\.xml$">
  ForceType application/xml
</FilesMatch>

# szybsze ładowanie: kompresja i długie zapamiętywanie plików, które nigdy się nie zmieniają
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/xml image/svg+xml application/json
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# panel admina nie jest dla wyszukiwarek
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/admin" ADMIN
  Header set X-Robots-Tag "noindex, nofollow" env=ADMIN
</IfModule>

# nagłówki bezpieczeństwa (to samo co na Vercel – next.config.mjs)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  # panel admina: połączenia tylko z tą stroną i z GitHubem
  <If "%{REQUEST_URI} =~ m#^/admin#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.github.com; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    Header always set Cache-Control "no-store"
  </If>
</IfModule>

# ukryte pliki (np. .git, .env) nigdy nie są wysyłane
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
